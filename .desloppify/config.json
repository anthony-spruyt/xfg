{
  "target_strict_score": 100,
  "review_max_age_days": 30,
  "review_batch_max_files": 80,
  "holistic_max_age_days": 30,
  "generate_scorecard": true,
  "badge_path": "scorecard.png",
  "exclude": [
    ".worktrees",
    ".output"
  ],
  "ignore": [
    ".output",
    "smells::src/cli/sync-command.ts::async_no_await",
    "smells::src/cli/sync-command.ts::nested_closure",
    "test_coverage::src/cli/types.ts::transitive_only",
    "review::.::holistic::cross_module_architecture::config_imports_settings_codescan_types",
    "review::.::holistic::dependency_health::dep_health_lockfile_p_retry_stale"
  ],
  "ignore_metadata": {},
  "zone_overrides": {
    ".output": "generated",
    ".output/updated_sources/src/vcs/authenticated-git-ops.ts": "generated"
  },
  "review_dimensions": [],
  "large_files_threshold": 0,
  "props_threshold": 0,
  "languages": {},
  "issue_noise_budget": 10,
  "issue_noise_global_budget": 0,
  "execution_log_max_entries": 10000,
  "needs_rescan": true,
  "commit_tracking_enabled": true,
  "commit_pr": 706,
  "commit_default_branch": "",
  "commit_message_template": "desloppify: {status} {count} issue(s) \u2014 {summary}",
  "trust_plugins": false,
  "transition_messages": {},
  "hermes_enabled": false,
  "hermes_models": {
    "execute": "openrouter:x-ai/grok-4.20-beta",
    "review": "openrouter:google/gemini-3.1-pro-preview"
  }
}
