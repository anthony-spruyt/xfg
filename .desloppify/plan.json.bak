      "action_steps": [
        {
          "title": "Narrow CreateAndMergeInput type boundary",
          "detail": "In src/sync/types.ts line 239, narrow CreateAndMergeInput by replacing 'repoConfig: RepoConfig' with 'prOptions?: PRMergeOptions'. The PRMergeHandler in src/sync/pr-merge-handler.ts accesses exactly repoConfig.prOptions (5 fields: labels on line 43, merge on line 48, mergeStrategy on line 56, deleteBranch on line 57, bypassReason on line 58). Change all 5 accesses from 'repoConfig.prOptions?.X' to 'input.prOptions?.X'. Update the caller in src/sync/sync-workflow.ts that constructs CreateAndMergeInput \u2014 replace 'repoConfig: this.repoConfig' with 'prOptions: this.repoConfig.prOptions'. Import PRMergeOptions from src/config/types.ts. This is a pure ISP improvement: the handler no longer receives files, settings, upstream, source, or git fields it never reads.",
          "effort": "small",
          "issue_refs": [
            "review::.::holistic::mid_level_elegance::pr_merge_handler_wide_boundary"
          ],
          "done": true
        }
      ]
