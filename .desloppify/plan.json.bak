        "review::.::holistic::low_level_elegance::formatter_renderTree_nesting::144fc191",
        "review::.::holistic::mid_level_elegance::executor_optional_assertion::b0fd80b0"
      ]
    },
    "review::.::holistic::mid_level_elegance::token-resolution-dual-path::78618e0c": {
      "original_id": "review::.::holistic::mid_level_elegance::token-resolution-dual-path::78618e0c",
      "original_detector": "review",
      "original_file": ".",
      "original_summary": "GitHub token resolution happens in two places during sync: once in processSingleRepo (line 353-363) to get repoToken for lifecycle/settings, and again inside AuthOptionsBuilder.resolve() when the processor runs. When the caller passes the pre-resolved token, AuthOptionsBuilder short-circuits, but if it doesn't (or passes undefined), the resolution runs again. This creates a subtle data-flow dependency where callers must remember to pre-resolve.",
      "status": "superseded",
      "superseded_at": "2026-03-06T13:26:46+00:00",
      "remapped_to": null,
      "candidates": [
        "review::.::holistic::high_level_elegance::github_utils_in_shared::1983c60a",
