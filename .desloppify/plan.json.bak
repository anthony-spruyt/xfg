    "review::.::holistic::mid_level_elegance::pr-creator-free-functions-vs-strategy::d75ff76a": {
      "original_id": "review::.::holistic::mid_level_elegance::pr-creator-free-functions-vs-strategy::d75ff76a",
      "original_detector": "review",
      "original_file": ".",
      "original_summary": "pr-creator.ts exposes createPR() and mergePR() as free functions that internally construct a PRStrategy via getPRStrategy() and (for create) wrap it in PRWorkflowExecutor. Meanwhile, PRMergeHandler and BranchManager also call getPRStrategy() separately. This means PRStrategy instances are created multiple times per repo (once in BranchManager.setupBranch for closeExistingPR, once in createPR, once in mergePR), with no reuse.",
      "status": "superseded",
      "superseded_at": "2026-03-06T13:26:46+00:00",
      "remapped_to": null,
      "candidates": [
        "review::.::holistic::high_level_elegance::github_utils_in_shared::1983c60a",
        "review::.::holistic::abstraction_fitness::authenticated_git_ops_wide_delegation::786c07e9",
