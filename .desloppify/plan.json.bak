      "depends_on_clusters": [
        "low-elegance-helper-extraction"
      ],
      "action_steps": [
        {
          "title": "Introduce SettingsProcessorFactories record collapsing four parallel factory fields",
          "detail": "In src/cli/types.ts define SettingsKind = 'rulesets'|'labels'|'repo'|'codeScanning' and SettingsProcessorFactories = Record<SettingsKind, SettingsProcessorFactory<ISettingsProcessor<...>>>. Replace the four flat factory fields in SyncDependencies, RepoIterationContext, and ApplyRepoSettingsContext with the record. Update buildSettingsDescriptors and all call sites to use the record.",
          "effort": "medium",
          "issue_refs": [
            "review::.::holistic::design_coherence::repo_iteration_context_factory_sprawl",
            "review::.::holistic::abstraction_fitness::settings_processor_factory_ceremony"
          ],
          "done": true
        },
        {
          "title": "Split validateSettings into per-concern dispatchers",
          "detail": "In src/config/validator.ts break validateSettings (~100 LOC) into validateSettingsRulesets, validateSettingsLabels, validateSettingsDeleteOrphaned, validateSettingsRepo, and validateSettingsCodeScanning. Keep validateSettings as a thin orchestrator calling each. Preserve existing shape/opt-out semantics and rootCtx cross-checks.",
          "effort": "small",
          "issue_refs": [
            "review::.::holistic::design_coherence::validate_settings_multi_concern"
          ],
          "done": true
        },
        {
          "title": "Validate test-suite stays green after each of the two concerns ship",
          "detail": "After the src/cli/types.ts SettingsProcessorFactories record lands (step 1 touching src/cli/sync-command.ts call sites), run npm test and npm run test:typecheck to confirm the four-factory call sites in src/sync/repository-processor.ts still compile. After the src/config/validator.ts validateSettings split lands (step 2), repeat both commands. If either test run regresses, fix in-place before moving on (do not batch-land).",
          "effort": "trivial",
          "issue_refs": [
            "repo_iteration_context_factory_sprawl",
            "validate_settings_multi_concern",
            "settings_processor_factory_ceremony"
          ],
          "done": true
        }
      ]
    },
