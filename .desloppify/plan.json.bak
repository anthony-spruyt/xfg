    "token-resolution": {
      "name": "token-resolution",
      "description": "Extract resolveGitHubToken from gh-api-utils.ts into dedicated auth module, centralize token resolution to happen once per repo",
      "issue_ids": [
        "review::.::holistic::abstraction_fitness::gh-api-utils-mixed-concerns",
        "review::.::holistic::package_organization::gh-api-utils-mixed-abstraction-levels",
        "review::.::holistic::mid_level_elegance::token-resolution-dual-path"
      ],
      "created_at": "2026-03-06T09:00:03+00:00",
      "updated_at": "2026-03-22T06:21:42+00:00",
      "auto": false,
      "cluster_key": "",
      "action": null,
      "user_modified": true,
      "action_steps": [
        {
          "title": "Move resolveGitHubToken to src/vcs/github-token-resolver.ts",
          "detail": "Extract resolveGitHubToken from src/shared/gh-api-utils.ts into a new dedicated module for token resolution. Update imports in src/cli/sync-command.ts.",
          "issue_refs": [],
          "effort": "medium",
          "done": true
        },
        {
          "title": "Update auth-options-builder.ts to be the single owner of token resolution",
          "detail": "Create IGitHubTokenResolver interface alongside the extracted function. Update src/sync/auth-options-builder.ts constructor to accept it.",
          "issue_refs": [],
          "effort": "medium",
          "done": true
        },
        {
          "title": "Remove duplicate resolution from sync-command.ts processSingleRepo",
          "detail": "In src/cli/sync-command.ts processSingleRepo, resolve token once and pass it to auth-options-builder instead of resolving twice.",
          "issue_refs": [],
          "effort": "medium",
          "done": true
        }
      ],
      "action_type": "manual_fix",
      "execution_policy": "planned_only",
      "execution_status": "review"
    },
